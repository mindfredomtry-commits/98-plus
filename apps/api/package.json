  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "build:verify": "node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-result-seen": "tsx scripts/backfill-result-seen.ts",
    "db:clear-user-bans": "tsx scripts/clear-user-bans.ts",
    "db:clear-ban-history": "tsx scripts/clear-ban-history.ts",
    "test:monetization-events": "tsx scripts/monetization-event-outbox.test.ts",
    "test:monetization-unit": "tsx scripts/monetization-unit.test.ts",
    "test:telegram-stars": "tsx scripts/telegram-stars.test.ts",
    "test:telegram-stars-provider": "tsx scripts/telegram-stars-provider.test.ts",
    "test:telegram-stars-integration": "tsx scripts/telegram-stars-integration.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@98plus/shared": "file:../../packages/shared",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
