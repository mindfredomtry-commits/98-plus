# Copy to apps/web/.env.local and restart `npm run dev -w @98plus/web`

# Production backend (Railway)
# NEXT_PUBLIC_API_URL=https://98plusapi-production.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://98plusapi-production.up.railway.app/ws

# Local tunnel example
NEXT_PUBLIC_API_URL=https://identify-pope-along-casa.trycloudflare.com
NEXT_PUBLIC_WS_URL=wss://identify-pope-along-casa.trycloudflare.com/ws
NEXT_PUBLIC_BOT_USERNAME=your_bot_username
# Phase12 owner diagnostics in production bundle (requires rebuild)
# NEXT_PUBLIC_PHASE12_DIAG=1
# Local browser dev without Telegram (needs API DEV_AUTH_ENABLED=true if API is production)
# NEXT_PUBLIC_DEV_AUTH_ENABLED=true
