# Database
DATABASE_URL=postgresql://ninety8:ninety8@localhost:5432/ninety8plus

# Redis
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=Ninety_eight_pluss_Bot

# API
API_PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=change_me_to_long_random_string
CORS_ORIGIN=http://localhost:3000
# Dev auth: POST/GET /auth/dev (off in production unless set)
# DEV_AUTH_ENABLED=true

# Web (Next.js) — MUST match backend tunnel when using Cloudflare/ngrok
NEXT_PUBLIC_API_URL=https://your-backend-tunnel.trycloudflare.com
NEXT_PUBLIC_WS_URL=wss://your-backend-tunnel.trycloudflare.com/ws
NEXT_PUBLIC_BOT_USERNAME=Ninety_eight_pluss_Bot

# Production WebApp URL (for bot menu button + CORS)
WEBAPP_URL=https://your-frontend-tunnel.trycloudflare.com

# API CORS (comma-separated origins, optional — trycloudflare auto-allowed in alpha)
CORS_ORIGIN=https://your-frontend-tunnel.trycloudflare.com
# CORS_ALLOW_ALL=true

# Alpha admin (comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=123456789

# Monetization internal processor (POST /internal/monetization/process-events)
# When unset, the endpoint is disabled (returns 404).
# MONETIZATION_INTERNAL_SECRET=change_me_to_long_random_string

# Telegram Stars payments (Mini App checkout)
# TELEGRAM_STARS_ENABLED=true
# TELEGRAM_STARS_TEST_MODE=false
# TELEGRAM_STARS_INVOICE_TITLE=98+ premium
# TELEGRAM_STARS_INVOICE_DESCRIPTION=Разовая покупка доступа 98+ premium
# PAYMENT_SUPPORT_CONTACT=@your_support_username
